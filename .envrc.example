. .venv/bin/activate

# ==============================================================================
# Cash-Plus Trading Copilot - Environment Configuration
# ==============================================================================

# --- Telegram Notifier Configuration ---
# Required for sending alerts and handling interactive button callbacks
export TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
export TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# --- LLM Provider Configuration ---
# Set the model name and provide the corresponding API key.
# LiteLLM format supported: e.g. "openai/gpt-4o", "anthropic/claude-3-5-sonnet-20241022", "gemini/gemini-2.5-flash"
export LLM_MODEL="openai/gpt-4o"
export OPENAI_API_KEY=""
export GEMINI_API_KEY=""
export ANTHROPIC_API_KEY=""

# --- Economic Calendar / Macro Feed (Optional override) ---
# Defaults to built-in free macro release calendar/ForexFactory scraper.
# If using Finnhub or another API:
export FINNHUB_API_KEY=""
export IEX_CLOUD_API_TOKEN=""

# --- Portfolio & Risk Overrides (Optional) ---
export PORTFOLIO_CASH="100000"
export MAX_NOTIONAL_EXPOSURE="60000"

# --- LangSmith Tracing & Evals (Optional) ---
export LANGCHAIN_TRACING_V2="false"
export LANGSMITH_API_KEY=""
export LANGCHAIN_API_KEY=""
export LANGCHAIN_PROJECT="trading-copilot"

# --- Broker Execution & Automated Trading ---
# Mode: "paper" (simulated fills against live quotes, default), "tradovate" (API execution), "alpaca" (equities/crypto execution), or "manual"
export EXECUTION_MODE="paper"

# --- Tradovate Credentials (Required only if EXECUTION_MODE="tradovate") ---
# Environment: "demo" (simulated execution on demo server) or "live"
export TRADOVATE_ENVIRONMENT="demo"
export TRADOVATE_API_KEY=""
export TRADOVATE_API_SECRET=""
export TRADOVATE_USERNAME=""
export TRADOVATE_PASSWORD=""
export TRADOVATE_ACCOUNT_ID=""

# --- Alpaca Credentials (Required only if EXECUTION_MODE="alpaca") ---
# Supports either APCA_API_KEY_ID or ALPACA_KEY_ID
export ALPACA_KEY_ID=""
export ALPACA_SECRET_KEY=""
export ALPACA_BASE_URL="https://paper-api.alpaca.markets"
export ALPACA_DATA_FEED="iex"
export ALPACA_PAPER="true"
